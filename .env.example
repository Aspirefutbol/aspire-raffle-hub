# ── Public (safe in the browser) ───────────────────────────────────────────────
# Supabase project URL and publishable (anon) key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Absolute site URL used for auth redirects (magic link).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Server-only secrets ───────────────────────────────────────────────────────
# Service-role key. ONLY used by scripts/seed-dev.mjs. The application never
# reads it. Never prefix with NEXT_PUBLIC_ and never set it in the web runtime.
SUPABASE_SECRET_KEY=
# Optional: password for development seed accounts.
SEED_PASSWORD=RaffleHub!dev1
